<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileOrbit.App.ViewModels.Pages"
             xmlns:c="using:FileOrbit.App.Controls"
             xmlns:v="using:FileOrbit.App.Views"
             x:Class="FileOrbit.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource about.title}" />
    <Border Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <Image Source="avares://FileOrbit/Assets/Icons/fileorbit.png" Width="72" Height="72" />
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="FileOrbit" FontSize="24" FontWeight="Bold" />
          <TextBlock Classes="muted" Text="{Binding Version}" />
          <TextBlock Classes="muted" Text="{DynamicResource about.license}" />
          <Button Classes="ghost" Padding="0" Click="OnOpenRepository" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Link}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding RepositoryUrl}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Button>
          <!-- This version's "What's new" slides again -->
          <Button x:Name="WhatsNewLink" Classes="ghost" Padding="0" Command="{Binding ShowWhatsNewCommand}" IsVisible="{Binding HasWhatsNew}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding WhatsNewText}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{DynamicResource general.check_updates}" />
        <TextBlock Classes="muted" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource general.check_now}" Command="{Binding CheckNowCommand}" />
          <Button Content="{Binding UpdateButtonText}" Command="{Binding DownloadUpdateCommand}"
                  IsVisible="{Binding UpdateAvailable}" />
        </StackPanel>
        <CheckBox Content="{DynamicResource general.check_updates}" IsChecked="{Binding CheckForUpdates}" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{DynamicResource feedback.issue}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource app.tagline}" />
        <Button Click="OnIssue" Content="{DynamicResource feedback.issue}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="{DynamicResource about.notices}" />
        <!-- The notices are in English: left to right in every language. -->
        <c:MarkdownView Markdown="{Binding Notices}" SkipTitle="True" FlowDirection="LeftToRight" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
