<!--
  FileOrbit.Cli: the "fileorbit" command line. Converts files and watches folders without the tray app, with the same
  engines, presets and settings. Published next to FileOrbit.exe as fileorbit-cli.exe (one runtime for both); the installer
  puts a "fileorbit" shim on PATH (cli\fileorbit.cmd).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fileorbit-cli</AssemblyName>
    <RootNamespace>FileOrbit.Cli</RootNamespace>
    <ApplicationIcon>..\FileOrbit.App\Assets\Icons\fileorbit.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileOrbit.Core\FileOrbit.Core.csproj" />
    <ProjectReference Include="..\FileOrbit.Engines\FileOrbit.Engines.csproj" />
  </ItemGroup>

  <!-- Error messages and built-in preset names, in English (the app's translation file). -->
  <ItemGroup>
    <EmbeddedResource Include="..\FileOrbit.App\Assets\i18n\en.json" LogicalName="FileOrbit.Cli.en.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FileOrbit.Cli.Tests" />
  </ItemGroup>
</Project>
