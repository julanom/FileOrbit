<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key><array><string>en</string><string>ko</string><string>zh-Hans</string></array>
    <key>CFBundleIdentifier</key><string>com.fileorbit.app</string>
    <key>CFBundleName</key><string>FileOrbit</string>
    <key>CFBundleDisplayName</key><string>FileOrbit</string>
    <key>CFBundleExecutable</key><string>FileOrbit</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__BUNDLE_VERSION__</string>
    <key>CFBundleIconFile</key><string>fileorbit.icns</string>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <!-- FileOrbit is a menu-bar utility, not a document app. Running as an agent keeps it out of the Dock and makes
         its floating radial window eligible to join other apps' full-screen Spaces. -->
    <key>LSUIElement</key><true/>
    <!-- "Convert with FileOrbit" in Finder's right-click menu, answered by the running app (MacOSServicesProvider).
         ServicesMenu.strings in ko.lproj and zh-Hans.lproj translate the title. An empty NSRequiredContext keeps
         the service on by default. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Convert with FileOrbit</string></dict>
            <key>NSMessage</key><string>convertFiles</string>
            <key>NSPortName</key><string>FileOrbit</string>
            <key>NSRequiredContext</key><dict/>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
    </array>
    <key>NSAppleEventsUsageDescription</key><string>FileOrbit reads selected Finder files when you use a file shortcut.</string>
    <key>NSInputMonitoringUsageDescription</key><string>FileOrbit detects your configured drag gestures to show the radial menu.</string>
</dict>
</plist>
